{
  "compilerOptions": {
    "outDir": "dist",

    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "noEmit": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "vite.*.config.ts",
    "forge.config.ts",
    "vite.renderer.config.mts",
    "vite.main.config.mts",
    "vite.preload.config.mts"
  ]
}
